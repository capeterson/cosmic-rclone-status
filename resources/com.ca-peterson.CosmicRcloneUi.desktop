[Desktop Entry]
Name=rclone UI
Comment=Show rclone mount and upload status in the panel
Type=Application
Exec=cosmic-rclone-ui
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;rclone;Drive;
Icon=com.ca-peterson.CosmicRcloneUi-symbolic
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
